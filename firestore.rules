rules_version = '2';

// Reglas de seguridad de LibreSense (Firestore).
// - Panelistas (sin cuenta): leen estudios activos y su diseño público (sin nombres de vinos),
//   y escriben sus respuestas y su progreso SOLO si el estudio está activo y con formato válido.
// - Administrador total (rol "super", o sin rol: el primero): todos los estudios y la lista de administradores.
// - Administradores (rol "admin"): crean estudios y solo pueden ver y modificar los suyos (campo "dueno").
//   El administrador total puede además compartir un estudio con administradores puntuales (campo "compartido"):
//   esos lo pueden ver (diseño, respuestas, análisis) pero no modificar ni borrar.
// - El primer administrador se registra solo, una única vez (meta/setup), como administrador total.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function esSuper() {
      return esAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.get('rol', 'super') == 'super';
    }
    // dueño del estudio: como está ahora (para leer) y como queda después de la escritura (para crear/modificar en lote)
    function puedeVer(e) {
      return esSuper() || (esAdmin()
        && get(/databases/$(database)/documents/estudios/$(e)).data.get('dueno', '') == request.auth.token.email);
    }
    function compartidoCon(e) {
      return esAdmin()
        && request.auth.token.email in get(/databases/$(database)/documents/estudios/$(e)).data.get('compartido', []);
    }
    function puedeLeer(e) { return puedeVer(e) || compartidoCon(e); }
    function puedeEscribir(e) {
      return esSuper() || (esAdmin()
        && getAfter(/databases/$(database)/documents/estudios/$(e)).data.get('dueno', '') == request.auth.token.email);
    }
    function estudioActivo(e) {
      return get(/databases/$(database)/documents/estudios/$(e)).data.activo == true;
    }
    function respuestaValida(r) {
      let d = request.resource.data;
      return d.keys().hasOnly(['Sesion', 'Valuador', 'Orden', 'CodigoProducto', 'valores', 'ts', 'tsCliente', 'def'])
        && d.keys().hasAll(['Sesion', 'Valuador', 'Orden', 'CodigoProducto', 'valores', 'ts'])
        && d.Sesion is string && d.Sesion.size() <= 20
        && d.Valuador is string && d.Valuador.size() <= 20
        && d.Orden is int && d.Orden >= 1 && d.Orden <= 100
        && d.CodigoProducto is string && d.CodigoProducto.size() <= 10
        && d.valores is map && d.valores.size() <= 300
        && (!('def' in d) || (d.def is map && d.def.size() <= 300))
        && d.ts == request.time
        && r == d.Valuador + '_' + d.Sesion + '_' + string(d.Orden);
    }

    // ---- administradores (id del documento = email)
    match /admins/{email} {
      allow get: if esSuper() || (autenticado() && request.auth.token.email == email);
      allow list: if esSuper();
      allow create: if (esSuper() && request.resource.data.get('rol', '') in ['admin', 'super'])
        || (autenticado() && request.auth.token.email == email
            && request.resource.data.get('rol', 'super') == 'super'
            && !exists(/databases/$(database)/documents/meta/setup)
            && getAfter(/databases/$(database)/documents/meta/setup).data.listo == true);
      allow update: if esSuper() && request.auth.token.email != email
        && request.resource.data.get('rol', '') in ['admin', 'super'];
      allow delete: if esSuper() && request.auth.token.email != email;
    }
    match /meta/setup {
      allow read: if true;
      allow create: if autenticado()
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && request.resource.data.keys().hasOnly(['listo']) && request.resource.data.listo == true;
      allow update, delete: if false;
    }

    // ---- estudios
    match /estudios/{e} {
      allow read: if true;
      allow create: if esAdmin() && request.resource.data.get('dueno', '') == request.auth.token.email;
      allow update: if puedeVer(e) && request.resource.data.get('dueno', '') == resource.data.get('dueno', '')
        && (esSuper() || request.resource.data.get('compartido', []) == resource.data.get('compartido', []));
      allow delete: if puedeVer(e);

      match /publico/{d} {
        allow read: if true;
        allow write: if puedeEscribir(e);
      }
      match /privado/{d} {
        allow read: if puedeLeer(e);
        allow write: if puedeEscribir(e);
      }
      match /respuestas/{r} {
        allow read: if puedeLeer(e);
        allow delete: if puedeVer(e);
        allow create, update: if estudioActivo(e) && respuestaValida(r);
      }
      match /progreso/{v} {
        allow read: if true;
        allow create, update: if estudioActivo(e) && v.size() <= 20 && request.resource.data.size() <= 300;
        allow delete: if puedeVer(e);
      }
    }
  }
}
